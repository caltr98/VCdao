<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram name="Open auction - push delivery" id="0">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1400" pageHeight="950" background="#ffffff" connect="1" arrows="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Open Dutch-auction delivery&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#555555&quot;&gt;DAO pays when the approved shares arrive&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontSize=25;" vertex="1" parent="1">
          <mxGeometry x="70" y="20" width="1100" height="65" as="geometry" />
        </mxCell>
        <mxCell id="gov" value="DAO Governance&lt;br&gt;&lt;span style='font-weight:normal;font-size:14px;color:#555555'&gt;&lt;i&gt;smart contract&lt;/i&gt;&lt;/span&gt;" style="sketch=0;outlineConnect=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=18;fontStyle=1;shape=mxgraph.aws4.blockchain_resource;fillColor=#232F3E;strokeColor=none;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="100" y="130" width="90" height="90" as="geometry" />
        </mxCell>
        <mxCell id="lock" value="Timelock&lt;br&gt;&lt;span style='font-weight:normal;font-size:14px;color:#555555'&gt;&lt;i&gt;smart contract&lt;/i&gt;&lt;/span&gt;" style="sketch=0;outlineConnect=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=18;fontStyle=1;shape=mxgraph.aws4.queue;fillColor=#1BA1E2;strokeColor=none;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="520" y="130" width="90" height="90" as="geometry" />
        </mxCell>
        <mxCell id="vault" value="BetVault&lt;br&gt;&lt;span style='font-weight:normal;font-size:14px;color:#555555'&gt;&lt;i&gt;DAO treasury smart contract&lt;/i&gt;&lt;/span&gt;" style="sketch=0;outlineConnect=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=18;fontStyle=1;shape=mxgraph.aws4.vault;fillColor=#f0a30a;strokeColor=#BD7000;aspect=fixed;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="1000" y="130" width="90" height="90" as="geometry" />
        </mxCell>
        <mxCell id="market" value="Polymarket&lt;br&gt;&lt;span style='font-weight:normal;font-size:14px;color:#555555'&gt;&lt;i&gt;CLOB: off-chain&lt;br&gt;exchange / CTF: contracts&lt;/i&gt;&lt;/span&gt;" style="sketch=0;outlineConnect=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=18;fontStyle=1;shape=mxgraph.aws4.marketplace;fillColor=#2F6FDB;strokeColor=none;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="100" y="430" width="90" height="90" as="geometry" />
        </mxCell>
        <mxCell id="wallet" value="Solver Deposit Wallet&lt;br&gt;&lt;span style='font-weight:normal;font-size:14px;color:#555555'&gt;&lt;i&gt;smart contract wallet&lt;br&gt;holds solver capital&lt;/i&gt;&lt;/span&gt;" style="sketch=0;outlineConnect=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=18;fontStyle=1;shape=mxgraph.aws4.vault;fillColor=#f0a30a;strokeColor=#BD7000;aspect=fixed;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="520" y="430" width="90" height="90" as="geometry" />
        </mxCell>
        <mxCell id="solver" value="Any solver&lt;br&gt;&lt;span style='font-weight:normal;font-size:14px;color:#555555'&gt;&lt;i&gt;person or bot&lt;br&gt;off-chain&lt;/i&gt;&lt;/span&gt;" style="sketch=0;outlineConnect=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=18;fontStyle=1;shape=mxgraph.aws4.user;fillColor=#E07B39;strokeColor=none;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="520" y="740" width="90" height="90" as="geometry" />
        </mxCell>
        <mxCell id="vote" value="1) Approve outcome, shares,&lt;br&gt;payment cap and deadline" edge="1" parent="1" source="gov" target="lock" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endSize=9;strokeWidth=2.5;fontSize=16;labelBackgroundColor=#ffffff;strokeColor=#232F3E;fontColor=#232F3E;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="authorize" value="2) authorizeBuy&lt;br&gt;executor = 0" edge="1" parent="1" source="lock" target="vault" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endSize=9;strokeWidth=2.5;fontSize=16;labelBackgroundColor=#ffffff;strokeColor=#232F3E;fontColor=#232F3E;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="order" value="3) Submit BUY order&lt;br&gt;using solver key" edge="1" parent="1" source="solver" target="market" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endSize=9;strokeWidth=2.5;fontSize=16;labelBackgroundColor=#ffffff;strokeColor=#E07B39;fontColor=#E07B39;exitX=0;exitY=0.5;entryX=0.5;entryY=1;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="145" y="785" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="fill" value="4) Buy shares with solver pUSD" edge="1" parent="1" source="market" target="wallet" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endSize=9;strokeWidth=2.5;fontSize=16;labelBackgroundColor=#ffffff;strokeColor=#2F6FDB;fontColor=#2F6FDB;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="push" value="5) Push exact shares via relayer&lt;br&gt;safeTransferFrom + (id, tx, order)" edge="1" parent="1" source="wallet" target="vault" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endSize=9;strokeWidth=2.5;fontSize=16;labelBackgroundColor=#ffffff;strokeColor=#2F6FDB;fontColor=#2F6FDB;exitX=1;exitY=0.3;entryX=0.5;entryY=1;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1045" y="457" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="pay" value="6) Atomic auction payment (pUSD)" edge="1" parent="1" source="vault" target="wallet" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endSize=9;strokeWidth=2.5;fontSize=16;labelBackgroundColor=#ffffff;strokeColor=#3F8624;fontColor=#3F8624;exitX=1;exitY=0.5;entryX=1;entryY=0.85;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1270" y="175" />
              <mxPoint x="1270" y="650" />
              <mxPoint x="700" y="650" />
              <mxPoint x="700" y="506" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="owner" value="Owner signs delivery" edge="1" parent="1" source="solver" target="wallet" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endSize=9;strokeWidth=2.5;fontSize=16;labelBackgroundColor=#ffffff;strokeColor=#E07B39;fontColor=#E07B39;exitX=0.5;exitY=0;entryX=0.5;entryY=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="price" value="&lt;b&gt;Auction price&lt;/b&gt;&lt;br&gt;0 at authorization to voted cap at deadline&lt;br&gt;Linear increase; first valid delivery wins&lt;br&gt;Solver waits until payment covers cost" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=16;align=left;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="735" y="280" width="480" height="115" as="geometry" />
        </mxCell>
        <mxCell id="checks" value="&lt;b&gt;Inside step 5: check and pay atomically&lt;/b&gt;&lt;br&gt;Correct token ; exact shares ; pending buy&lt;br&gt;Before deadline ; unused order hash&lt;br&gt;Payment at most voted cap&lt;br&gt;&lt;br&gt;Invalid delivery reverts the whole transfer.&lt;br&gt;Tx / order hashes are audit references." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F3EAF8;strokeColor=#9673A6;fontSize=16;align=left;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="805" y="720" width="480" height="170" as="geometry" />
        </mxCell>
        <mxCell id="expire" value="&lt;b&gt;No delivery by deadline&lt;/b&gt;&lt;br&gt;expire(id) releases reserved pUSD.&lt;br&gt;Funds stay in the DAO treasury." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;align=left;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="75" y="735" width="320" height="115" as="geometry" />
        </mxCell>
        <mxCell id="proof" value="&lt;b&gt;Polygon live run ; 2 October 2026&lt;/b&gt;&lt;br&gt;5 shares ; solver cost 1.25 pUSD ; paid 1.259906 pUSD ; cap 1.625 pUSD&lt;br&gt;Delivery: 0x55d5f53a...29bbe613" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=15;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="75" y="590" width="510" height="105" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
