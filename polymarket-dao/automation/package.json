  },
  "overrides": {
    "wrangler": "$wrangler",
    "miniflare": "5.20260925.0-alpha"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.141.0"
  }
}
